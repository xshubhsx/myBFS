rules_version = '2';

// Starter security rules for when this app is connected to a real
// Firebase project (see README.md → "Upgrading to real Firebase").
// Bills and customers are append-only from the client: create + read
// are allowed for signed-in users, update/delete are blocked so a
// bill can never be silently overwritten from the app itself.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /bills/{billId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // bills are immutable once saved
    }

    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
